{
  "name": "dcbc-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/check-build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "calendar:dev": "node --env-file=.env.test.local --experimental-strip-types scripts/calendar-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.10.0",
    "typescript-eslint": "^8.42.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.3.10"
  }
}
